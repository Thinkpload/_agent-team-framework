# Remote Terminal Configuration
# Copy this file to config.env and fill in your values

# Port to run the web terminal on
RT_PORT=7681

# Username and password for web access (basic auth)
RT_USER=admin
RT_PASS=changeme123

# tmux session name
RT_SESSION=claude-remote

# Claude Code working directory (absolute path)
RT_WORKDIR=~/projects

# Bind to Tailscale interface only (1 = yes, recommended).
# Traffic is already WireGuard-encrypted — no TLS needed.
# Set to 0 to bind on all interfaces (LAN + Tailscale).
RT_BIND_TAILSCALE=1
