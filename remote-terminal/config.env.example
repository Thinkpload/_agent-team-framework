# Remote Terminal Configuration
# Copy this file to config.env and fill in your values

# Port to run the web terminal on
RT_PORT=7681

# Username and password for web access (basic auth)
RT_USER=admin
RT_PASS=changeme123

# tmux session name
RT_SESSION=claude-remote

# Claude Code working directory (absolute path)
RT_WORKDIR=~/projects

# Optional: Tailscale hostname or ngrok URL (leave empty for LAN-only access)
RT_PUBLIC_URL=

# TLS: set to 1 to enable self-signed HTTPS (recommended for external access)
RT_TLS=0
